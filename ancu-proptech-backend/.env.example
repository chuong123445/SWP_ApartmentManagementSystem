# Copy to .env.local; use tools/start-local.ps1. Never commit actual secrets.
SPRING_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=proptech_db;encrypt=true;trustServerCertificate=true
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=replace-with-your-sql-password
# Base64 of at least 32 random bytes. Local/test profiles allow an ephemeral key.
APP_JWT_SECRET=
# Real Gmail SMTP; password is a Google App Password (not the normal login password).
APP_MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_FROM=
MAIL_PASSWORD=
# Base64 of at least 32 persistent random bytes, separate from JWT signing key.
APP_OTP_SECRET=
APP_BILLING_FIXTURES=true
LOCAL_TENANT_1_EMAIL=tenant1@ancu.local
LOCAL_TENANT_1_PASSWORD=
LOCAL_TENANT_2_EMAIL=tenant2@ancu.local
LOCAL_TENANT_2_PASSWORD=
LOCAL_OWNER_EMAIL=owner@ancu.local
LOCAL_OWNER_PASSWORD=replace-with-a-random-password-at-least-12-characters
LOCAL_CUSTOMER_EMAIL=customer@ancu.local
LOCAL_CUSTOMER_PASSWORD=replace-with-a-random-password-at-least-12-characters
# local profile only; initialization requires all three discovery/rental tables empty.
APP_SEED_DATA=true
# Optional staff account provisioning, local profile only. No public Admin registration.
# Existing Admin password/status/history remain unchanged; existing Owner/Customer is never promoted.
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
LOCAL_ADMIN_NAME=Admin An Cư

# Auth0 VNeID: public SPA settings; see docs/setup/auth0-vneid.md
AUTH0_VNEID_ENABLED=false
AUTH0_ISSUER=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=
AUTH0_CONNECTION=Username-Password-Authentication
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
