{
  "openapi": "3.1.0",
  "info": {
    "title": "An Cu AI assistance",
    "version": "1.2.0",
    "description": "Customer search intent only; inventory remains GET /api/v1/apartments. See customer-ai-search-v1 ADR. Private applicant draft precheck is independent of Admin review. See owner-dossier-precheck-v1 ADR. Home chat supports contextual answers and automatically applies validated search filters (2026-11-09)."
  },
  "paths": {
    "/api/v1/apartments/ai-search": {
      "post": {
        "description": "Return runId/sourceHash/model/promptVersion/createdAt/filters/notes/canApply. No generated inventory. 10 requests/minute/process per remote hash. Equivalent city prefixes (Thành phố/TP./bare name), case and accents resolve only against the eligible public address catalog. Original text remains the audit hash input; provider request city spelling is normalized before extraction. Budget and hierarchy validations remain enforced.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text",
                  "consent"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "consent": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated result"
          },
          "400": {
            "description": "Invalid input/consent"
          },
          "404": {
            "description": "Expired or unknown run"
          },
          "409": {
            "description": "Already applied with different filters"
          },
          "429": {
            "description": "Rate/capacity limit"
          },
          "503": {
            "description": "AI unavailable/invalid result; normal search still available"
          }
        }
      }
    },
    "/api/v1/apartments/ai-search/{id}/apply": {
      "post": {
        "description": "Return reviewed filters and record user acceptance. UUID capability expires in15min; later changes use ordinary filters or a new run.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "filters"
                ],
                "properties": {
                  "filters": {
                    "$ref": "#/components/schemas/Filters"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated result"
          },
          "400": {
            "description": "Invalid input/consent"
          },
          "404": {
            "description": "Expired or unknown run"
          },
          "409": {
            "description": "Already applied with different filters"
          },
          "429": {
            "description": "Rate/capacity limit"
          },
          "503": {
            "description": "AI unavailable/invalid result; normal search still available"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/owner/properties/{id}/ai-precheck": {
      "post": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "description": "Read private current draft checklist; optional single own uploaded file scan after consent and matching sourceHash. Revalidates source after provider call; never reads Admin review. Returns sourceHash/propertyVersion/checklist/files/runId/model/promptVersion/finishedAt/review.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "draft"
                ],
                "properties": {
                  "draft": {
                    "$ref": "#/components/schemas/PrecheckDraft"
                  },
                  "sourceHash": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "fileId": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "consent": {
                    "type": "boolean",
                    "description": "Must be true for each provider file request."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Private result/no-store"
          },
          "400": {
            "description": "Invalid input/consent"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Account not eligible"
          },
          "404": {
            "description": "Foreign or missing property/file/run"
          },
          "409": {
            "description": "Stale source or submitted/approved state"
          },
          "429": {
            "description": "40 requests/minute per applicant/process or capacity limit"
          },
          "503": {
            "description": "AI incomplete/unavailable; normal submission remains available"
          }
        }
      }
    },
    "/api/v1/owner/properties/{id}/ai-precheck/{runId}/acknowledge": {
      "post": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "description": "Record exact actor/property/source completed precheck as reviewed. No submission/state change.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "draft",
                  "sourceHash"
                ],
                "properties": {
                  "draft": {
                    "$ref": "#/components/schemas/PrecheckDraft"
                  },
                  "sourceHash": {
                    "type": "string",
                    "maxLength": 64
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Private result/no-store"
          },
          "400": {
            "description": "Invalid input/consent"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Account not eligible"
          },
          "404": {
            "description": "Foreign or missing property/file/run"
          },
          "409": {
            "description": "Stale source or submitted/approved state"
          },
          "429": {
            "description": "40 requests/minute per applicant/process or capacity limit"
          },
          "503": {
            "description": "AI incomplete/unavailable; normal submission remains available"
          }
        }
      }
    },
