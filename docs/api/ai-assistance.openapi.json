    "/api/v1/apartments/ai-chat": {
      "post": {
        "description": "Public consented conversation; returns reply (plain text <=2000) and search (existing Result with filters, notes, canApply, runId). Automatic frontend apply only when canApply and nonempty filters. Same rate limit as ai-search. Raw conversation/reply not stored. Inventory stays GET /api/v1/apartments. Equivalent city prefixes (Thành phố/TP./bare name), case and accents resolve only against the eligible public address catalog. Original text remains the audit hash input; provider request city spelling is normalized before extraction. Budget and hierarchy validations remain enforced.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text",
                  "consent",
                  "history"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "consent": {
                    "const": true
                  },
                  "history": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "object",
                      "required": [
                        "role",
                        "text"
                      ],
                      "properties": {
                        "role": {
                          "enum": [
                            "user",
                            "assistant"
                          ]
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2000
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated reply and search capability; Cache-Control no-store"
          },
          "400": {
            "description": "Invalid input/consent/history"
          },
          "429": {
            "description": "Rate/capacity limit"
          },
          "503": {
            "description": "AI unavailable or invalid output; normal filters remain usable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Filters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "q": {
            "type": [
              "string",
              "null"
            ]
          },
          "city": {
            "type": [
              "string",
              "null"
            ]
          },
          "district": {
            "type": [
              "string",
              "null"
            ]
          },
          "ward": {
            "type": [
              "string",
              "null"
            ]
          },
          "minRent": {
            "type": [
              "string",
              "null"
            ]
          },
          "maxRent": {
            "type": [
              "string",
              "null"
            ]
          },
          "minArea": {
            "type": [
              "string",
              "null"
            ]
          },
          "maxArea": {
            "type": [
              "string",
              "null"
            ]
          },
          "bedrooms": {
            "type": [
              "integer",
              "null"
            ]
          },
          "occupants": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      },
      "PrecheckDraft": {
        "type": "object",
        "description": "Same supported fields as PropertyDossierSubmit. Partial values accepted for local checklist; propertyVersion/rightType/documentFileIds required; use an empty documentFileIds list when no file is selected. Other lists default to empty, max20 unique own uploaded files total; purpose and ownership checked. Unknown fields rejected. Input serialized size <=20k chars.",
        "required": [
          "propertyVersion",
          "rightType",
          "documentFileIds"
        ],
        "properties": {
          "propertyVersion": {
            "type": "integer",
            "minimum": 0
          },
          "rightType": {
            "type": "string",
            "enum": [
              "OWNERSHIP",
              "AUTHORIZATION",
              "SUBLEASE"
            ]
          },
          "receivingAccount": {
            "type": "object",
            "properties": {
              "bank": {
                "type": "string"
              },
              "accountNumber": {
                "type": "string"
              },
              "accountHolderName": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "documentFileIds": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          },
          "supportingFileIds": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          },
          "ownerEvidenceFileIds": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          },
          "authorizationFileIds": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          },
          "originalLeaseFileIds": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          },
          "subleaseConsentFileIds": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          },
          "certificateNumber": {
            "type": [
              "string",
              "null"
            ]
          },
          "certificateIssueDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "certificateIssuePlace": {
            "type": [
              "string",
              "null"
            ]
          },
          "exploitationRightDescription": {
            "type": [
              "string",
              "null"
            ]
          },
          "rightsValidFrom": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "rightsValidUntil": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "originalLeaseFrom": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "originalLeaseUntil": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "principalName": {
            "type": [
              "string",
              "null"
            ]
          },
          "principalDocumentNumber": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
