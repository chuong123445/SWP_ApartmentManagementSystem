{
  "openapi": "3.0.3",
  "info": {
    "title": "An Cu ordinary registration and Owner upgrade",
    "version": "2.0.0",
    "description": "Asset-bound activation replaces consent/count-based role promotion. Current source consent/self asset endpoints are in asset-management.openapi.json."
  },
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "summary": "Register an ordinary CUSTOMER; caller cannot select a role",
        "security": [
          {
            "csrf": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "email",
                  "password",
                  "fullName"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "password": {
                    "type": "string",
                    "minLength": 12,
                    "maxLength": 72
                  },
                  "fullName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "phone": {
                    "type": "string",
                    "maxLength": 20
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "AuthUserResponse CUSTOMER/PENDING_VERIFICATION; no session or password returned"
          },
          "400": {
            "description": "Invalid/unknown fields including requestedRole and role"
          },
          "403": {
            "description": "Missing CSRF"
          },
          "409": {
            "description": "Email already used"
          }
        }
      }
    },
    "/api/v1/me/owner-upgrade": {
      "get": {
        "summary": "Read own upgrade prerequisites without contacting asset provider",
        "security": [
          {
            "internalBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "{role, identityVerified, assetServiceAvailable, version}; no-store; no M2M credentials/asset list"
          },
          "401": {
            "description": "Missing or invalid session"
          }
        }
      },
      "post": {
        "summary": "Deprecated: Customer must complete property onboarding; consent alone never promotes",
        "description": "Returns409 PROPERTY_ONBOARDING_REQUIRED for Customer, with no provider asset read or role change. Existing Owner returns current AuthUserResponse unchanged for compatibility. Use relationship selection, source consent, then successful source property creation; manual AUTHORIZATION/SUBLEASE grants Owner only on Admin approval.",
        "security": [
          {
            "internalBearer": [],
            "csrf": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "consent",
                  "version"
                ],
                "properties": {
                  "consent": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  },
                  "version": {
                    "type": "integer",
                    "format": "int64",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing Owner only, unchanged account"
          },
          "400": {
            "description": "Invalid consent/version/unknown fields"
          },
          "401": {
            "description": "Invalid session"
          },
          "403": {
            "description": "Missing CSRF"
          },
          "409": {
            "description": "PROPERTY_ONBOARDING_REQUIRED"
          }
        },
        "deprecated": true
      }
    }
  },
  "components": {
    "securitySchemes": {
      "internalBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Internal session JWT"
      },
      "csrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-XSRF-TOKEN"
      }
    }
  }
}
