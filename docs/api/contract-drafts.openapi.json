  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Clause": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "title",
          "body"
        ],
        "additionalProperties": false
      },
      "Create": {
        "type": "object",
        "properties": {
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "description": "Strictly after startDate."
          },
          "monthlyRent": {
            "type": "string",
            "pattern": "^\\d{1,13}(\\.\\d{1,2})?$",
            "description": "VND/reading decimal; max DECIMAL(15,2)."
          },
          "electricityUnitPrice": {
            "type": "string",
            "pattern": "^\\d{1,13}(\\.\\d{1,2})?$",
            "description": "VND/reading decimal; max DECIMAL(15,2)."
          },
          "waterUnitPrice": {
            "type": "string",
            "pattern": "^\\d{1,13}(\\.\\d{1,2})?$",
            "description": "VND/reading decimal; max DECIMAL(15,2)."
          },
          "deposit": {
            "type": "string",
            "pattern": "^\\d{1,13}(\\.\\d{1,2})?$",
            "description": "VND/reading decimal; max DECIMAL(15,2)."
          },
          "paymentDay": {
            "type": "integer",
            "minimum": 1,
            "maximum": 28
          },
          "paymentMethod": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "usagePurpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "clauses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Clause"
            },
            "minItems": 1,
            "maxItems": 30
          },
          "requestVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "sourceVersion": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "startDate",
          "endDate",
          "monthlyRent",
          "electricityUnitPrice",
          "waterUnitPrice",
          "deposit",
          "paymentDay",
          "paymentMethod",
          "usagePurpose",
          "clauses",
          "requestVersion",
          "sourceVersion"
        ],
        "additionalProperties": false
      },
      "Update": {
        "type": "object",
        "properties": {
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "description": "Strictly after startDate."
          },
          "monthlyRent": {
            "type": "string",
            "pattern": "^\\d{1,13}(\\.\\d{1,2})?$",
            "description": "VND/reading decimal; max DECIMAL(15,2)."
          },
          "electricityUnitPrice": {
            "type": "string",
            "pattern": "^\\d{1,13}(\\.\\d{1,2})?$",
            "description": "VND/reading decimal; max DECIMAL(15,2)."
          },
          "waterUnitPrice": {
            "type": "string",
            "pattern": "^\\d{1,13}(\\.\\d{1,2})?$",
            "description": "VND/reading decimal; max DECIMAL(15,2)."
          },
          "deposit": {
            "type": "string",
            "pattern": "^\\d{1,13}(\\.\\d{1,2})?$",
            "description": "VND/reading decimal; max DECIMAL(15,2)."
          },
          "paymentDay": {
            "type": "integer",
            "minimum": 1,
            "maximum": 28
          },
          "paymentMethod": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "usagePurpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "clauses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Clause"
            },
            "minItems": 1,
            "maxItems": 30
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
