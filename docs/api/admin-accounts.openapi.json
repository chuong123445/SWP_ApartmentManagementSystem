{
  "openapi": "3.1.0",
  "info": {
    "title": "An Cư Admin account management",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/admin/accounts": {
      "get": {
        "summary": "Search and filter user accounts; ACTIVE ADMIN only",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          },
          {
            "name": "filter",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Filter"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Private paginated result; Cache-Control no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "400": {
            "description": "Invalid search, status or pagination"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Active Admin required"
          }
        }
      }
    },
    "/admin/accounts/{id}/actions": {
      "post": {
        "summary": "Lock, unlock or delete an Owner or Customer account with optimistic version checking",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Command"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sessions revoked and action recorded; business history determines deletion mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                }
              }
            }
          },
          "400": {
            "description": "Reason required or invalid request"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Active Admin required; Admin accounts are protected"
          },
          "404": {
            "description": "Account not found"
          },
          "409": {
            "description": "STALE_VERSION, ACCOUNT_DELETED, ACCOUNT_STATUS_CHANGED or related-data conflict"
          }
        }
      }
    },
    "/admin/accounts/{id}": {
      "get": {
        "summary": "Read common account profile, including locked or soft-deleted accounts",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Private read; Cache-Control no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "400": {
            "description": "Invalid pagination"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Active Admin required"
          },
          "404": {
            "description": "Account not found"
          }
        }
      }
    },
    "/admin/accounts/{id}/contracts": {
      "get": {
        "summary": "Paginated contracts where the account is the actual landlord or tenant",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Private read; Cache-Control no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid pagination"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Active Admin required"
          },
          "404": {
            "description": "Account not found"
          }
        }
      }
    },
    "/admin/accounts/{id}/paid-invoices": {
      "get": {
        "summary": "Paginated paid monthly invoices and tenant-linked additional receipts across both contract parties",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Private read; Cache-Control no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaidInvoicePage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid pagination"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Active Admin required"
          },
          "404": {
            "description": "Account not found"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Filter": {
        "type": "string",
        "enum": [
          "ALL",
          "ACTIVE",
          "PENDING_VERIFICATION",
          "LOCKED",
          "INACTIVE",
          "DELETED"
        ],
        "default": "ALL"
      },
      "Account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "fullName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "OWNER",
              "CUSTOMER"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "PENDING_VERIFICATION",
              "LOCKED",
              "INACTIVE"
            ]
          },
          "deletedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "canManage": {
            "type": "boolean"
          },
          "canUnlock": {
            "type": "boolean"
          }
        }
      },
      "Page": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Account"
            }
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "totalElements": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          }
        }
      },
      "Command": {
        "type": "object",
        "required": [
          "action",
          "version",
          "reason"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "LOCK",
              "UNLOCK",
              "DELETE"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "Result": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "LOCKED",
              "UNLOCKED",
              "SOFT_DELETED",
              "HARD_DELETED"
            ]
          }
        }
      },
      "Profile": {
        "type": "object",
        "properties": {
          "account": {
            "$ref": "#/components/schemas/Account"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "bio": {
            "type": [
              "string",
              "null"
            ]
          },
          "dateOfBirth": {
            "type": [
              "string",
              "null"
            ]
          },
          "emailVerified": {
            "type": "boolean"
          },
          "phoneVerified": {
            "type": "boolean"
          }
        }
      },
      "Contract": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "roomNumber": {
            "type": "string"
          },
          "propertyName": {
            "type": "string"
          },
          "ownerName": {
            "type": "string"
          },
          "tenantName": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "startDate": {
            "type": "string"
          },
          "endDate": {
            "type": "string"
          },
          "monthlyRent": {
            "type": "string"
          },
          "relationship": {
            "type": "string",
            "enum": [
              "OWNER",
              "TENANT"
            ]
          }
        }
      },
      "PaidInvoice": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "contractId": {
            "type": "string"
          },
          "roomNumber": {
            "type": "string"
          },
          "ownerName": {
            "type": "string"
          },
          "tenantName": {
            "type": "string"
          },
          "amount": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "MONTHLY",
              "ADDITIONAL"
            ]
          },
          "period": {
            "type": [
              "string",
              "null"
            ]
          },
          "paidAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ContractPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Contract"
            }
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "totalElements": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          }
        }
      },
      "PaidInvoicePage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaidInvoice"
            }
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "totalElements": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          }
        }
      }
    }
  }
}
