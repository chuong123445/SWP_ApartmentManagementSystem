  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "EvidenceFile": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "RIGHT_DOCUMENT",
              "SUPPORTING",
              "OWNER_IDENTITY",
              "AUTHORIZATION_DOCUMENT",
              "ORIGINAL_LEASE",
              "SUBLEASE_CONSENT"
            ]
          },
          "filename": {
            "type": "string"
          },
          "contentType": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5242880
          }
        },
        "required": [
          "id",
          "purpose",
          "filename",
          "contentType",
          "size"
        ]
      },
      "ReceivingAccount": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "bank": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "accountNumber": {
            "type": "string",
            "pattern": "^[0-9]{4,40}$"
          },
          "accountHolderName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "bank",
          "accountNumber",
          "accountHolderName"
        ]
      },
      "DossierSubmit": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "propertyVersion": {
            "type": "integer",
            "minimum": 0
          },
          "rightType": {
            "type": "string",
            "enum": [
              "OWNERSHIP",
              "AUTHORIZATION",
              "SUBLEASE"
            ]
          },
          "receivingAccount": {
            "$ref": "#/components/schemas/ReceivingAccount"
          },
          "documentFileIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "minItems": 1,
            "maxItems": 20
          },
          "supportingFileIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "minItems": 0,
            "maxItems": 20
          },
          "ownerEvidenceFileIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "minItems": 0,
            "maxItems": 20
          },
          "certificateNumber": {
            "type": "string",
            "maxLength": 100,
            "nullable": true
          },
          "certificateIssueDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "certificateIssuePlace": {
            "type": "string",
            "maxLength": 200,
            "nullable": true
          },
          "exploitationRightDescription": {
            "type": "string",
            "maxLength": 1000,
            "nullable": true
          },
          "rightsValidFrom": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "rightsValidUntil": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "originalLeaseFrom": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "originalLeaseUntil": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "principalName": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "principalDocumentNumber": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{12}$"
          },
          "authorizationFileIds": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          },
          "originalLeaseFileIds": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          },
          "subleaseConsentFileIds": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        },
        "required": [
          "propertyVersion",
          "rightType",
          "receivingAccount",
          "documentFileIds"
        ],
        "description": "AUTHORIZATION requires rightsValidFrom/Until, principalName/CCCD, original ownership documentFileIds and authorizationFileIds. SUBLEASE additionally requires originalLeaseFrom/Until, originalLeaseFileIds and separate subleaseConsentFileIds. Rights range must be inside original lease, not expired; no automatic one-year inference. All papers must belong to exact property with exact purpose; max20 total. VERIFIED Auth0 required."
      },
      "DossierDecision": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "APPROVE",
              "REQUEST_ADDITIONAL_INFORMATION",
              "REJECT"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000,
            "description": "Nonblank required for non-approval."
          },
          "rightsConfirmed": {
            "type": "boolean",
            "default": false,
            "description": "Required true for APPROVE of AUTHORIZATION/SUBLEASE after human checks scope and dates."
          }
        },
        "required": [
          "decision",
          "version"
        ]
      },
      "Dossier": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "propertyId": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "propertyName": {
            "type": "string"
          },
          "propertyAddress": {
            "type": "string"
          },
          "applicantName": {
            "type": "string"
          },
          "rightType": {
            "type": "string",
            "enum": [
              "OWNERSHIP",
              "AUTHORIZATION",
              "SUBLEASE"
            ]
          },
          "bank": {
            "type": "string"
          },
          "accountNumber": {
            "type": "string"
          },
          "accountHolderName": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING_APPROVAL",
              "NEEDS_INFORMATION",
              "APPROVED",
              "REJECTED"
            ]
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvidenceFile"
            },
            "minItems": 1,
            "maxItems": 20
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time"
          },
          "reviewedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "reviewReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "certificateNumber": {
            "type": "string",
            "maxLength": 100,
            "nullable": true
          },
          "certificateIssueDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "certificateIssuePlace": {
            "type": "string",
            "maxLength": 200,
            "nullable": true
          },
          "exploitationRightDescription": {
            "type": "string",
            "maxLength": 1000,
            "nullable": true
          },
          "localFixture": {
            "type": "boolean",
            "readOnly": true,
            "description": "Explicit local illustrative dossier; not a real Admin evidence review."
          },
          "rightsValidFrom": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "rightsValidUntil": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "originalLeaseFrom": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "originalLeaseUntil": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "principalName": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          },
          "principalDocumentNumber": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{12}$"
          },
          "applicantDocumentNumber": {
            "description": "Private persisted verified citizen number; never public listing.",
            "type": [
              "string",
              "null"
            ]
          },
          "renewal": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "propertyId",
          "propertyName",
          "propertyAddress",
          "applicantName",
          "rightType",
          "bank",
          "accountNumber",
          "accountHolderName",
          "status",
          "files",
          "submittedAt",
          "reviewedAt",
          "reviewReason",
          "version"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "DossierPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Dossier"
            },
            "minItems": 0,
            "maxItems": 100
          },
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "totalElements": {
            "type": "integer",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "items",
          "page",
          "size",
          "totalElements",
          "totalPages"
        ]
      }
    }
  }
}
