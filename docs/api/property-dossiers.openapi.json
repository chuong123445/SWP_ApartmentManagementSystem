{
  "openapi": "3.1.0",
  "info": {
    "title": "An Cu Private Property Dossiers and Admin Review",
    "version": "1.1.0",
    "description": "Implemented private PDF/JPEG/PNG up to10MB, VNeID-verified submissions, AUTHORIZATION/SUBLEASE typed papers and validity, Admin confirmation/promotion, append-only renewal. SQL binary private storage, no malware-scan/OCR claim. Self application/expiry endpoints are described in property-rights.openapi.json."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/owner/properties/{id}/evidence-files": {
      "post": {
        "operationId": "uploadPrivatePropertyEvidence",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        ],
        "description": "Exact verified Owner property; DRAFT/NEEDS_INFORMATION/REJECTED or legacy pending with no dossier. Genuine PDF/JPEG/PNG, 5MB and 20M pixels, decoded/re-encoded without metadata. Max200 stored uploads/property; no PDF/SVG/public URL.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "purpose": {
                    "type": "string",
                    "enum": [
                      "RIGHT_DOCUMENT",
                      "SUPPORTING",
                      "OWNER_IDENTITY",
                      "AUTHORIZATION_DOCUMENT",
                      "ORIGINAL_LEASE",
                      "SUBLEASE_CONSENT"
                    ]
                  },
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "purpose",
                  "file"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Private evidence metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceFile"
                }
              }
            }
          },
          "400": {
            "description": "Rejected by validation, authentication, ownership, current state/version or upload size",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Rejected by validation, authentication, ownership, current state/version or upload size",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Rejected by validation, authentication, ownership, current state/version or upload size",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Rejected by validation, authentication, ownership, current state/version or upload size",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Rejected by validation, authentication, ownership, current state/version or upload size",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Rejected by validation, authentication, ownership, current state/version or upload size",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/owner/properties/{id}/verification-dossiers": {
      "post": {
        "operationId": "submitOwnerPropertyDossier",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        ],
        "description": "Versioned property lock. At least one own RIGHT_DOCUMENT, at most20 unique files of correct purpose/property. Preserves earlier submissions; owner/applicant/status/time assigned on server. Pending with any existing dossier/approved cannot resubmit; legacy pending without dossier may submit once without resetting property.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DossierSubmit"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "New pending dossier; property becomes pending atomically",
            "content": {
              "application/json": {
