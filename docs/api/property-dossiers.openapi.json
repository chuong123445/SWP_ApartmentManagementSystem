    "/api/v1/admin/property-dossiers/{id}/decisions": {
      "post": {
        "operationId": "decidePropertyDossier",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        ],
        "description": "ACTIVE ADMIN, pending dossier/current integer version only, property+dossier transaction/locks. Reviewer/time/reason persisted. Per-property approval does not publish apartments or verify account/identity automatically.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DossierDecision"
              }
            }
          }
        },
