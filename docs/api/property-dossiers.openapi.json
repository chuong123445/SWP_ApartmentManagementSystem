    "/api/v1/property-evidence-files/{id}": {
      "get": {
        "operationId": "downloadPrivatePropertyEvidence",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        ],
        "description": "Exact submitting applicant or owning Owner; ACTIVE Admin only for files referenced by submitted dossiers. Private attachment/no-store/nosniff; no public URL.",
        "responses": {
          "200": {
            "description": "Validated PDF or canonical raster attachment",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              },
              "Content-Disposition": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Content-Type-Options": {
                "schema": {
                  "const": "nosniff"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "No staff/Owner access"
          },
          "404": {
            "description": "Missing or not accessible"
          }
        }
      }
    },
    "/api/v1/admin/property-dossiers": {
      "get": {
        "operationId": "adminPropertyDossierQueue",
        "description": "ACTIVE ADMIN only; submitted dossiers oldest first. Metadata only; binary content stored separately.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "PENDING_APPROVAL",
                "NEEDS_INFORMATION",
                "APPROVED",
                "REJECTED"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Private dossier queue",
            "content": {
              "application/json": {
                "schema": {
