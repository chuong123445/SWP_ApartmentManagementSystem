{
  "openapi": "3.0.3",
  "info": {
    "title": "An Cu VNeID property import",
    "version": "1.1.0",
    "description": "Updated 24 November 2026: Auth0/VNeID is account authentication/identity verification only. Property source selection, import, append and consent writes are retired. All new property rights use manual input and dossier/Admin review. Historical property provenance remains readable without automatic data reset or demotion."
  },
  "paths": {
    "/api/v1/owner/properties/vneid-assets": {
      "get": {
        "summary": "Retired property source operation",
        "security": [
          {
            "internalBearer": []
          }
        ],
        "responses": {
          "410": {
            "description": "PROPERTY_SOURCE_RETIRED — use manual property dossier flow"
          },
          "401": {
            "description": "Authentication required"
          },
          "400": {
            "description": "Invalid legacy request body"
          }
        },
        "deprecated": true,
        "description": "Authenticated valid requests return 410 PROPERTY_SOURCE_RETIRED. No Auth0 property read, import, publication or role grant is performed. Old consent cannot authorize this operation."
      }
    },
    "/api/v1/owner/properties/vneid-imports": {
      "post": {
        "summary": "Retired property source operation",
        "description": "Authenticated valid requests return 410 PROPERTY_SOURCE_RETIRED. No Auth0 property read, import, publication or role grant is performed. Old consent cannot authorize this operation.",
        "security": [
          {
            "internalBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Import"
              }
            }
          }
        },
        "responses": {
          "410": {
            "description": "PROPERTY_SOURCE_RETIRED — use manual property dossier flow"
          },
          "401": {
            "description": "Authentication required"
          },
          "400": {
            "description": "Invalid legacy request body"
          }
        },
        "deprecated": true
      }
    },
    "/api/v1/owner/properties/{id}/receiving-account": {
      "put": {
        "summary": "Exact active Owner updates private receiving account for imported source property",
        "security": [
          {
            "internalBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReceivingAccountUpdate"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Saved with optimistic version; no-store. Existing draft snapshots unchanged."
          },
          "400": {
            "description": "Invalid fields or ACCOUNT_HOLDER_MISMATCH"
          },
          "403": {
            "description": "Not active Owner or VNEID_LINK_CHANGED"
          },
          "404": {
            "description": "Property not owned by caller"
          },
          "409": {
            "description": "VERSION_CONFLICT or SOURCE_PROPERTY_REQUIRED"
          }
        }
      }
    },
    "/api/v1/owner/properties/{id}/vneid-units": {
      "post": {
        "summary": "Retired property source operation",
        "description": "Authenticated valid requests return 410 PROPERTY_SOURCE_RETIRED. No Auth0 property read, import, publication or role grant is performed. Old consent cannot authorize this operation.",
        "security": [
          {
            "internalBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppendUnits"
              }
            }
          }
        },
        "responses": {
          "410": {
            "description": "PROPERTY_SOURCE_RETIRED — use manual property dossier flow"
          },
          "401": {
            "description": "Authentication required"
          },
          "400": {
            "description": "Invalid legacy request body"
          }
        },
        "deprecated": true
      }
    }
  },
  "components": {
    "securitySchemes": {
      "internalBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Import": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "externalAssetId",
          "sourceVersion",
          "city",
          "district",
          "units",
          "imageIds"
        ],
        "properties": {
          "externalAssetId": {
            "type": "string",
            "maxLength": 100
          },
          "sourceVersion": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "district": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "ward": {
            "type": "string",
            "nullable": true,
            "maxLength": 80
          },
          "units": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/UnitTerms"
            }
          },
          "imageIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "description": "Own unused staged property-image IDs. Order determines cover. Bound atomically."
          }
        }
      },
      "UnitTerms": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "externalUnitId",
          "monthlyRent",
          "deposit",
          "electricityUnitPrice",
          "waterUnitPrice",
          "floor",
          "maxOccupants",
          "imageIds"
        ],
        "properties": {
          "externalUnitId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "monthlyRent": {
            "type": "string",
            "description": "Decimal >0, up to 13 integer/2 fraction digits"
          },
          "deposit": {
            "type": "string",
            "description": "Decimal >=0, up to 13 integer/2 fraction digits"
          },
          "electricityUnitPrice": {
            "type": "string",
            "description": "Decimal >=0 VND/kWh, explicit zero allowed"
          },
          "waterUnitPrice": {
            "type": "string",
            "description": "Decimal >=0 VND/m3, explicit zero allowed"
          },
          "electricityIndex": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 2147483647
          },
          "waterIndex": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 2147483647
          },
          "floor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200
          },
          "maxOccupants": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "description": {
            "type": "string",
            "maxLength": 3000,
            "default": ""
          },
          "imageIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "string"
            },
            "description": "Required1–4 private staging room images for each selected unit. Common property images do not replace own room photos. Initial import and append both enforce publication readiness in the creation transaction."
          }
        }
      },
      "ReceivingAccountUpdate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "bank": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "accountNumber": {
            "type": "string",
            "pattern": "^[0-9A-Za-z-]{4,50}$"
          },
          "accountHolderName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "format": "int64"
          }
        },
        "required": [
          "bank",
          "accountNumber",
          "accountHolderName",
          "version"
        ]
      },
      "AppendUnits": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "sourceVersion",
          "units"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "sourceVersion": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "units": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/UnitTerms"
            }
          }
        }
      }
    }
  }
}
