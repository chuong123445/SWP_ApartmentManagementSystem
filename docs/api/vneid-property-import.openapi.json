{
  "openapi": "3.0.3",
  "info": {
    "title": "An Cu VNeID property import",
    "version": "1.1.0",
    "description": "Implemented Auth0 simulation source. Source-owned assets only; manual property review remains separate. Source evidence stays separate from Admin decisions; properties/units stay shared. Source rightDescription is retained for new imports. Receiving account is owner-declared, name-matched to linked verified citizen; not bank verification."
  },
  "paths": {
    "/api/v1/owner/properties/vneid-assets": {
      "get": {
        "summary": "Read linked verified Owner's eligible source assets on explicit selection",
        "security": [
          {
            "internalBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Private/no-store candidates; each {asset:{externalAssetId,name,address,rentalMode,certificateNumber,certificateDate,certificatePlace,units:[{externalUnitId,code,areaM2,bedrooms,bathrooms}]},sourceVersion:SHA256,imported:boolean}. No issuer/subject/token/credentials."
          },
          "401": {
            "description": "Invalid session"
          },
          "403": {
            "description": "Not active verified Owner or VNEID_REQUIRED"
          },
          "503": {
            "description": "Provider unavailable/invalid; no sample fallback"
          }
        }
      }
    },
    "/api/v1/owner/properties/vneid-imports": {
      "post": {
        "summary": "Complete rental terms and import/publish a source-owned asset without Admin review",
        "description": "Server rereads exact linked subject and exact asset, checks sourceVersion and complete exact unit set; locks/rechecks owner session/link; unique issuer+external_asset_id. Atomic Property APPROVED, Apartment PUBLISHED/VACANT, rates/baselines and V15 private source audit. No fake Admin decision. Cannot add manual units into imported property. Caller cannot select account/owner/approval/area/address/source/verified fields. Rentable status is not contract activation or payment.",
        "security": [
          {
            "internalBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Import"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "OwnerPropertyCreated {property,apartments}; no-store. Property includes verificationSource AUTH0_VNEID_SIMULATION. Apartment/public detail include nullable electricityUnitPrice/waterUnitPrice decimal strings."
          },
          "400": {
            "description": "Invalid/missing terms, unknown fields, ASSET_UNITS_MISMATCH"
          },
          "401": {
            "description": "Invalid/revoked session"
          },
          "403": {
            "description": "Wrong role/status or VNEID_REQUIRED"
          },
          "404": {
            "description": "ASSET_NOT_AVAILABLE"
          },
          "409": {
            "description": "ASSET_ALREADY_IMPORTED, ASSET_SOURCE_CHANGED, VNEID_LINK_CHANGED or concurrent RESOURCE_CONFLICT"
          },
          "503": {
            "description": "Source error; no writes"
          }
        }
      }
    },
    "/api/v1/owner/properties/{id}/receiving-account": {
      "put": {
        "summary": "Exact active Owner updates private receiving account for imported source property",
        "security": [
          {
            "internalBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReceivingAccountUpdate"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Saved with optimistic version; no-store. Existing draft snapshots unchanged."
          },
          "400": {
            "description": "Invalid fields or ACCOUNT_HOLDER_MISMATCH"
          },
          "403": {
            "description": "Not active Owner or VNEID_LINK_CHANGED"
          },
          "404": {
            "description": "Property not owned by caller"
          },
          "409": {
            "description": "VERSION_CONFLICT or SOURCE_PROPERTY_REQUIRED"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "internalBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Import": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "externalAssetId",
          "sourceVersion",
          "city",
          "district",
          "units",
          "imageIds"
        ],
        "properties": {
          "externalAssetId": {
            "type": "string",
            "maxLength": 100
          },
          "sourceVersion": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "district": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "ward": {
            "type": "string",
            "nullable": true,
            "maxLength": 80
          },
          "units": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/UnitTerms"
            }
          },
          "imageIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "description": "Own unused staged property-image IDs. Order determines cover. Bound atomically."
          }
        }
      },
      "UnitTerms": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "externalUnitId",
          "monthlyRent",
          "deposit",
          "electricityUnitPrice",
          "waterUnitPrice",
          "electricityIndex",
          "waterIndex",
          "floor",
          "maxOccupants"
        ],
        "properties": {
          "externalUnitId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "monthlyRent": {
            "type": "string",
            "description": "Decimal >0, up to 13 integer/2 fraction digits"
          },
          "deposit": {
            "type": "string",
            "description": "Decimal >=0, up to 13 integer/2 fraction digits"
          },
          "electricityUnitPrice": {
            "type": "string",
            "description": "Decimal >=0 VND/kWh, explicit zero allowed"
          },
          "waterUnitPrice": {
            "type": "string",
            "description": "Decimal >=0 VND/m3, explicit zero allowed"
          },
          "electricityIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "waterIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "floor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200
          },
          "maxOccupants": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "description": {
            "type": "string",
            "maxLength": 3000,
            "default": ""
          }
        }
      },
      "ReceivingAccountUpdate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "bank": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "accountNumber": {
            "type": "string",
            "pattern": "^[0-9A-Za-z-]{4,50}$"
          },
          "accountHolderName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "format": "int64"
          }
        },
        "required": [
          "bank",
          "accountNumber",
          "accountHolderName",
          "version"
        ]
      }
    }
  }
}
