{
  "openapi": "3.1.0",
  "info": {
    "title": "An Cu Tenant Billing",
    "version": "1.1.0",
    "description": "Implemented private monthly billing, Owner draft/send/edit/cancel with audit history, and exact Customer-as-Tenant receipt. Contract and payment flows are documented separately. See docs/decisions/invoice-draft-changes-v1.md."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/owner/tenancies": {
      "get": {
        "parameters": [],
        "responses": {
          "200": {
            "description": "Current verified Owner's contract relationships, latest start date first.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Tenancy"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/me/tenancies": {
      "get": {
        "parameters": [],
        "responses": {
          "200": {
            "description": "Current verified Customer's contract relationships, including history.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Tenancy"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/owner/contracts/{id}/billing-context": {
      "get": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Next calendar-month period, source readings and agreed prices. Start readings come from the last SENT invoice, then the contract baseline, then zero when absent. Initial partial month charges full monthly rent. Draft predecessor/ended contract return 409; this GET never changes readings.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BillingContext"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/owner/contracts/{id}/invoices": {
      "post": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvoiceCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Immutable DRAFT, totals calculated in BigDecimal from contract. Advances chain version; one invoice per contract/period.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/owner/invoices/{id}/send": {
      "post": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvoiceSend"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Atomically SENT + unique tenant notification. Retry of already SENT is idempotent. Never marks paid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/owner/invoices": {
      "get": {
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "propertyId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "description": "Intersect exact property with current Owner scope before count/pagination; another Owner or absent property yields empty page."
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ALL",
                "DRAFT",
                "UNPAID",
                "PAID",
                "CANCELLED"
              ],
              "default": "ALL"
            },
            "description": "Owner/property scoped status filter before paging/count. SENT and payment status remain separate; UNPAID and PAID include sent invoices only."
          }
        ],
        "responses": {
          "200": {
            "description": "Own apartments only; drafts and sent; createdAt/id descending.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoicePage"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/me/invoices": {
      "get": {
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "paymentStatus",
            "in": "query",
            "required": false,
            "description": "Filter before pagination. ALL preserves existing API behavior; tenant UI defaults to UNPAID. PAID requires a server-confirmed payment receipt.",
            "schema": {
              "type": "string",
              "enum": [
                "ALL",
                "UNPAID",
                "PAID"
              ],
              "default": "ALL"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Only current Customer's SENT invoices, including ended-contract history; createdAt/id descending.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoicePage"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/invoices/{id}": {
      "get": {
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owning verified Owner, or exact verified tenant for SENT only. No other-party access.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/owner/invoices/{id}/draft": {
      "patch": {
        "description": "Owner-only DRAFT update with frozen prices/fees and server recomputation. Both version tokens required. Saves same-period readings and before/after audit atomically.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current invoice or event history.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvoiceDraftChange"
              }
            }
          }
        }
      }
    },
    "/api/v1/owner/invoices/{id}/cancel": {
      "post": {
        "description": "Owner-only DRAFT cancellation retained as CANCELLED. Same actor/reason retry is idempotent. A new invoice may be created for this period; SENT alone advances baseline/month. No refund or payment effect.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current invoice or event history.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvoiceCancel"
              }
            }
          }
        }
      }
    },
    "/api/v1/owner/invoices/{id}/history": {
      "get": {
        "description": "Owner-only append-only history of create/update/cancel/send; older documents only have events since feature deployment. Payment audit is separate.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current invoice or event history.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/InvoiceHistoryEntry"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "Error": {
        "description": "Validation/ownership/state/chain error; no private evidence or token data.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "code",
                "message"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "Invoice": {
        "type": "object",
        "required": [
          "id",
          "contractId",
          "apartmentId",
          "customerId",
          "roomNumber",
          "apartmentTitle",
          "tenantName",
          "period",
          "dueDate",
          "monthlyRent",
          "electricityStartReading",
          "electricityEndReading",
          "electricityQuantity",
          "electricityUnitPrice",
          "electricityAmount",
          "waterStartReading",
          "waterEndReading",
          "waterQuantity",
          "waterUnitPrice",
          "waterAmount",
          "totalAmount",
          "status",
          "createdAt",
          "sentAt",
          "version",
          "billingVersion"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "contractId": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "apartmentId": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "customerId": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "roomNumber": {
            "type": "string"
          },
          "apartmentTitle": {
            "type": "string"
          },
          "tenantName": {
            "type": "string"
          },
          "period": {
            "type": "string"
          },
          "dueDate": {
            "type": "string",
            "format": "date"
          },
          "monthlyRent": {
            "type": "string",
            "description": "Exact decimal string; no client totals/prices accepted."
          },
          "electricityStartReading": {
            "type": "string",
            "description": "Exact decimal string; no client totals/prices accepted."
          },
          "electricityEndReading": {
            "type": "string",
            "description": "Exact decimal string; no client totals/prices accepted."
          },
          "electricityQuantity": {
            "type": "string",
            "description": "Exact decimal string; no client totals/prices accepted."
          },
          "electricityUnitPrice": {
            "type": "string",
            "description": "Exact decimal string; no client totals/prices accepted."
          },
          "electricityAmount": {
            "type": "string",
            "description": "Exact decimal string; no client totals/prices accepted."
          },
          "waterStartReading": {
            "type": "string",
            "description": "Exact decimal string; no client totals/prices accepted."
          },
          "waterEndReading": {
            "type": "string",
            "description": "Exact decimal string; no client totals/prices accepted."
          },
          "waterQuantity": {
            "type": "string",
            "description": "Exact decimal string; no client totals/prices accepted."
          },
          "waterUnitPrice": {
            "type": "string",
            "description": "Exact decimal string; no client totals/prices accepted."
          },
          "waterAmount": {
            "type": "string",
            "description": "Exact decimal string; no client totals/prices accepted."
          },
          "totalAmount": {
            "type": "string",
            "description": "Exact decimal string; no client totals/prices accepted."
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "SENT",
              "CANCELLED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "sentAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "paymentStatus": {
            "type": "string",
            "enum": [
              "UNPAID",
              "PAID"
            ]
          },
          "paidAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "billingVersion": {
            "type": "integer",
            "minimum": 0,
            "description": "Current contract billing-chain token; required together with invoice version for draft changes."
          }
        }
      },
      "InvoicePage": {
        "type": "object",
        "required": [
          "items",
          "page",
          "size",
          "totalElements",
          "totalPages"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Invoice"
            }
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "totalElements": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          }
        }
      },
      "BillingContext": {
        "type": "object",
        "required": [
          "contractId",
          "apartmentId",
          "roomNumber",
          "tenantName",
          "period",
          "baselineVersion",
          "monthlyRent",
          "electricityStartReading",
          "electricityUnitPrice",
          "waterStartReading",
          "waterUnitPrice"
        ],
        "properties": {
          "contractId": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "apartmentId": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "roomNumber": {
            "type": "string"
          },
          "tenantName": {
            "type": "string"
          },
          "period": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}$"
          },
          "baselineVersion": {
            "type": "integer",
            "minimum": 0
          },
          "monthlyRent": {
            "type": "string",
            "description": "Exact decimal string; no client totals/prices accepted."
          },
          "electricityStartReading": {
            "type": "string",
            "description": "Exact decimal string; no client totals/prices accepted."
          },
          "electricityUnitPrice": {
            "type": "string",
            "description": "Exact decimal string; no client totals/prices accepted."
          },
          "waterStartReading": {
            "type": "string",
            "description": "Exact decimal string; no client totals/prices accepted."
          },
          "waterUnitPrice": {
            "type": "string",
            "description": "Exact decimal string; no client totals/prices accepted."
          }
        }
      },
      "Tenancy": {
        "type": "object",
        "description": "Owner-scoped or exact-Self contract relationship. Contract deposit is the saved agreement, not proof of receipt. Verification summaries are separate from in-app signing; no identity documents or signature images are returned. Responses are no-store.",
        "required": [
          "id",
          "apartmentId",
          "customerId",
          "roomNumber",
          "apartmentTitle",
          "propertyName",
          "customerName",
          "customerEmail",
          "status",
          "startDate",
          "endDate",
          "monthlyRent",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "apartmentId": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "customerId": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "roomNumber": {
            "type": "string"
          },
          "apartmentTitle": {
            "type": "string"
          },
          "propertyName": {
            "type": "string"
          },
          "customerName": {
            "type": "string"
          },
          "customerEmail": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "ACTIVE",
              "ENDED",
              "CANCELLED"
            ]
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "monthlyRent": {
            "type": "string",
            "description": "Exact decimal string; no client totals/prices accepted."
          },
          "version": {
            "type": "integer"
          },
          "contractDeposit": {
            "type": [
              "string",
              "null"
            ],
            "description": "Exact decimal saved on this contract's authoring terms, including a genuine zero. Null when legacy terms are missing; never inferred from current apartment deposit or treated as actual money received."
          },
          "customerEmailVerified": {
            "type": "boolean"
          },
          "customerIdentityStatus": {
            "type": "string",
            "enum": [
              "VERIFIED",
              "NOT_VERIFIED"
            ],
            "description": "Accepted persisted evidence under VerifiedIdentityPolicy; independent of email or the account identityVerified summary flag."
          },
          "customerIdentitySource": {
            "type": [
              "string",
              "null"
            ],
            "description": "Accepted evidence source only. AUTH0_VNEID_SIMULATION remains simulation; LOCAL_DEMO is accepted only in local/non-prod. No provider subject, citizen data or documents included."
          },
          "inAppSigningStatus": {
            "type": "string",
            "enum": [
              "NO_DATA",
              "UNSIGNED",
              "OWNER_SIGNED",
              "CUSTOMER_SIGNED",
              "BOTH_SIGNED"
            ],
            "description": "Persisted signing timestamps on existing authoring terms, not a certified digital-signature provider result. Missing legacy terms are NO_DATA, not BOTH_SIGNED just because the contract is ACTIVE."
          },
          "localFixture": {
            "type": "boolean",
            "description": "Marks illustrative contract data, not actual party consent."
          }
        }
      },
      "InvoiceCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "period",
          "dueDate",
          "electricityEndReading",
          "waterEndReading",
          "baselineVersion"
        ],
        "properties": {
          "period": {
            "type": "string",
