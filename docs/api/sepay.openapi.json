{
  "openapi": "3.1.0",
  "info": {
    "title": "An Cu SePay invoice payments",
    "version": "1.0.0",
    "description": "BIDV official VA and other linked bank accounts via SePay API v2. Existing invoice SENT/DRAFT lifecycle retained; paymentStatus/paidAt are separate."
  },
  "security": [
    {
      "Bearer": []
    }
  ],
  "paths": {
    "/api/v1/owner/payments/sepay": {
      "get": {
        "summary": "Owner reads own connection, never key/hash",
        "responses": {
          "200": {
            "description": "Saved/private result; Cache-Control no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Connection"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or provider token/data"
          },
          "401": {
            "description": "Missing/invalid session or webhook API key"
          },
          "403": {
            "description": "Role/account verification denied"
          },
          "404": {
            "description": "Not exact invoice party"
          },
          "409": {
            "description": "Stale version, invoice not SENT, missing config/public URL, fractional VND"
          },
          "503": {
            "description": "Provider unavailable"
          }
        }
      },
      "put": {
        "summary": "Owner imports provider-backed receiver using transient API token",
        "responses": {
          "200": {
            "description": "Saved/private result; Cache-Control no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Connection"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or provider token/data"
          },
          "401": {
            "description": "Missing/invalid session or webhook API key"
          },
          "403": {
            "description": "Role/account verification denied"
          },
          "404": {
            "description": "Not exact invoice party"
          },
          "409": {
            "description": "Stale version, invoice not SENT, missing config/public URL, fractional VND"
          },
          "503": {
            "description": "Provider unavailable"
          },
          "429": {
            "description": "SePay provider rate limit; wait before retrying"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Setup"
              }
            }
          }
        }
      }
    },
    "/api/v1/owner/payments/sepay/bank-accounts": {
      "post": {
        "summary": "Read active bank accounts from SePay v2; page/per_page=100, returns items/page/hasMore",
        "responses": {
          "200": {
            "description": "Saved/private result; Cache-Control no-store"
          },
          "400": {
            "description": "Invalid input or provider token/data"
