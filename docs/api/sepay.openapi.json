            "description": "Provider unavailable"
          },
          "429": {
            "description": "SePay provider rate limit; wait before retrying"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiToken"
              }
            }
          }
        }
      }
    },
    "/api/v1/owner/payments/sepay/virtual-accounts": {
      "post": {
        "summary": "Read active official static VAs from SePay v2; items/page/hasMore",
        "responses": {
          "200": {
            "description": "Saved/private result; Cache-Control no-store"
          },
          "400": {
            "description": "Invalid input or provider token/data"
          },
          "401": {
