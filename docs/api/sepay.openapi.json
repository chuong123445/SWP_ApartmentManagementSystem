  },
  "components": {
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "SepayKey": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Apikey <one-time owner webhook key>"
      }
    },
    "schemas": {
      "Connection": {
        "type": "object",
        "properties": {
          "bank": {
            "type": [
              "string",
              "null"
            ]
          },
          "accountNumber": {
            "type": [
              "string",
              "null"
            ]
          },
          "accountHolderName": {
            "type": [
              "string",
              "null"
            ]
          },
          "virtualAccount": {
            "type": [
              "string",
              "null"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "configured": {
            "type": "boolean"
          },
          "webhookUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "lastWebhookAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "webhookSecret": {
            "type": [
              "string",
              "null"
            ],
            "description": "One-time on create/rotate only; GET never returns it"
          }
        }
      },
      "Setup": {
        "type": "object",
        "required": [
          "apiToken",
          "bankAccountId",
          "enabled",
          "version"
        ],
        "properties": {
          "apiToken": {
            "type": "string",
            "writeOnly": true,
            "maxLength": 4096
          },
          "bankAccountId": {
            "type": "string"
          },
          "virtualAccountId": {
            "type": [
              "string",
              "null"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ApiToken": {
        "type": "object",
        "required": [
          "apiToken",
          "page"
        ],
        "properties": {
          "apiToken": {
            "type": "string",
            "writeOnly": true
          },
          "page": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "VaRequest": {
        "type": "object",
        "required": [
          "apiToken",
          "bankAccountId",
          "page"
        ],
        "properties": {
          "apiToken": {
            "type": "string",
            "writeOnly": true
          },
          "bankAccountId": {
            "type": "string"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Rotate": {
        "type": "object",
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Payment": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "UNPAID",
              "PAID",
              "NOT_CONFIGURED"
            ]
          },
          "paymentCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "amount": {
            "type": [
              "string",
              "null"
            ]
          },
          "bank": {
            "type": [
              "string",
              "null"
            ]
          },
          "accountNumber": {
            "type": [
              "string",
              "null"
            ]
          },
          "accountHolderName": {
            "type": [
              "string",
              "null"
            ]
          },
          "qrUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "paidAt": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Webhook": {
        "type": "object",
        "required": [
          "id",
          "gateway",
          "accountNumber",
          "content",
          "transferType",
          "transferAmount"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "0 is the observed SePay Gửi thử connectivity probe: API key still required; only lastWebhookAt updated, no ledger/invoice payment writes. Real transaction IDs must be positive."
          },
          "gateway": {
            "type": "string"
          },
          "accountNumber": {
            "type": "string"
          },
          "subAccount": {
            "type": [
              "string",
              "null"
            ]
          },
          "code": {
            "type": [
              "string",
              "null"
            ]
          },
          "content": {
            "type": "string"
          },
          "transferType": {
            "type": "string",
            "enum": [
              "in",
              "out"
            ]
          },
          "transferAmount": {
            "type": "number",
            "minimum": 1,
            "multipleOf": 1
          }
        }
      },
      "Status": {
        "type": "object",
        "required": [
          "enabled",
          "version"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "TestPaymentRequest": {
        "type": "object",
        "required": [
          "amount"
        ],
        "properties": {
          "amount": {
            "type": "string",
            "pattern": "^[0-9]{1,9}$",
            "description": "Whole VND 1..999999999; zero is rejected. Real transfer, not a rental invoice."
          },
          "contractId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[1-9][0-9]*$",
            "description": "Optional own ACTIVE contract. Server derives exact tenant; omitted means owner-only test."
          }
        }
      },
      "TestReceipt": {
        "type": "object",
        "required": [
          "id",
          "createdAt",
          "payment"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "payment": {
            "$ref": "#/components/schemas/Payment"
          },
          "contractId": {
            "type": [
              "string",
              "null"
            ]
          },
          "tenantName": {
            "type": [
              "string",
              "null"
            ]
          },
          "roomNumber": {
            "type": [
              "string",
              "null"
            ]
          },
          "ownerName": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "TestRecipient": {
        "type": "object",
        "required": [
          "contractId",
          "tenantName",
          "roomNumber"
        ],
        "properties": {
          "contractId": {
            "type": "string"
          },
          "tenantName": {
            "type": "string"
          },
          "roomNumber": {
            "type": "string"
          }
        }
      }
    }
  }
}
