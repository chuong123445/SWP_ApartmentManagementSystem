        }
      }
    },
    "/api/v1/owner/payments/sepay/test-payments": {
      "get": {
        "summary": "Owner-only latest 20 test receipts; independent of rental debts/revenue",
        "responses": {
          "200": {
            "description": "Saved/private result; Cache-Control no-store",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TestReceipt"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or provider token/data"
          },
          "401": {
            "description": "Missing/invalid session or webhook API key"
          },
          "403": {
            "description": "Role/account verification denied"
          },
          "404": {
            "description": "Not exact invoice party"
          },
          "409": {
            "description": "Stale version, invoice not SENT, missing config/public URL, fractional VND"
          },
          "503": {
            "description": "Provider unavailable"
          }
        }
      },
      "post": {
        "summary": "Create real-money test receipt, optionally send atomically to tenant of own ACTIVE contract. Receiver customerId always derives from server contract; no arbitrary account selection or rental debt changes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TestPaymentRequest"
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Invalid input or provider token/data"
          },
          "401": {
            "description": "Missing/invalid session or webhook API key"
          },
          "403": {
            "description": "Role/account verification denied"
          },
          "404": {
            "description": "Not exact invoice party"
          },
          "409": {
            "description": "Stale version, invoice not SENT, missing config/public URL, fractional VND"
          },
          "503": {
            "description": "Provider unavailable"
          },
          "201": {
            "description": "New private real-money test receipt; Cache-Control no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestReceipt"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/owner/payments/sepay/test-recipients": {
      "get": {
        "summary": "Own ACTIVE contract recipients only; server tenant and room labels",
