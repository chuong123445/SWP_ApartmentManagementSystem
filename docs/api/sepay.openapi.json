            "description": "Provider unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Rotate"
              }
            }
          }
        }
      }
    },
    "/api/v1/owner/payments/sepay/events": {
      "get": {
        "summary": "Own latest 20 events; transactionId/invoiceId/testPaymentId/result/amount/receivedAt; exactly one receipt reference for matched payment",
        "responses": {
          "200": {
            "description": "Saved/private result; Cache-Control no-store"
          },
          "400": {
            "description": "Invalid input or provider token/data"
          },
          "401": {
            "description": "Missing/invalid session or webhook API key"
          },
          "403": {
            "description": "Role/account verification denied"
          },
          "404": {
            "description": "Not exact invoice party"
          },
          "409": {
            "description": "Stale version, invoice not SENT, missing config/public URL, fractional VND"
          },
          "503": {
            "description": "Provider unavailable"
          }
        }
      }
    },
    "/api/v1/invoices/{id}/payment": {
      "get": {
        "summary": "Exact owner/tenant SENT invoice status; optional existing QR",
        "responses": {
          "200": {
            "description": "Saved/private result; Cache-Control no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or provider token/data"
          },
          "401": {
            "description": "Missing/invalid session or webhook API key"
          },
          "403": {
            "description": "Role/account verification denied"
          },
          "404": {
            "description": "Not exact invoice party"
          },
          "409": {
            "description": "Stale version, invoice not SENT, missing config/public URL, fractional VND"
          },
          "503": {
            "description": "Provider unavailable"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        ]
      },
      "post": {
        "summary": "Idempotently issue immutable invoice QR snapshot from server total; no client amount",
        "responses": {
          "200": {
            "description": "Saved/private result; Cache-Control no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or provider token/data"
          },
          "401": {
            "description": "Missing/invalid session or webhook API key"
          },
          "403": {
            "description": "Role/account verification denied"
          },
          "404": {
            "description": "Not exact invoice party"
          },
          "409": {
            "description": "Stale version, invoice not SENT, missing config/public URL, fractional VND"
          },
          "503": {
            "description": "Provider unavailable"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        ]
      }
    },
    "/api/v1/payments/sepay/webhooks/{ownerId}": {
      "post": {
        "summary": "API-key webhook; durable exact reconciliation or review event; duplicate transaction id no-op",
        "responses": {
          "200": {
            "description": "Saved/private result; Cache-Control no-store",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": true
                    }
                  },
                  "required": [
                    "success"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or provider token/data"
          },
          "401": {
            "description": "Missing/invalid session or webhook API key"
          },
          "403": {
            "description": "Role/account verification denied"
          },
          "404": {
            "description": "Not exact invoice party"
          },
          "409": {
            "description": "Stale version, invoice not SENT, missing config/public URL, fractional VND"
          },
          "503": {
            "description": "Provider unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Webhook"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "ownerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        ],
        "security": [
          {
            "SepayKey": []
          }
        ]
      }
    },
    "/api/v1/owner/payments/sepay/status": {
      "patch": {
        "summary": "Exact Owner enables/pauses existing connection using only internal session and version; no provider token",
        "responses": {
          "200": {
            "description": "Saved/private result; Cache-Control no-store",
            "content": {
              "application/json": {
                "schema": {
