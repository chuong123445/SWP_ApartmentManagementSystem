          },
          "403": {
            "description": "Role/account verification denied"
          },
          "404": {
            "description": "Not exact invoice party"
          },
          "409": {
            "description": "Stale version, invoice not SENT, missing config/public URL, fractional VND"
          },
          "503": {
            "description": "Provider unavailable"
          }
        }
      }
    },
    "/api/v1/me/payments/sepay/test-payments": {
      "get": {
        "summary": "Exact recipient latest 20 test receipts with QR and webhook-derived status; CUSTOMER or OWNER as tenant; never owner-only old receipts",
        "responses": {
          "200": {
            "description": "Saved/private result; Cache-Control no-store",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TestReceipt"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or provider token/data"
          },
          "401": {
            "description": "Missing/invalid session or webhook API key"
          },
          "403": {
            "description": "Role/account verification denied"
          },
          "404": {
            "description": "Not exact invoice party"
          },
          "409": {
            "description": "Stale version, invoice not SENT, missing config/public URL, fractional VND"
          },
          "503": {
            "description": "Provider unavailable"
          }
        }
      }
    },
    "/api/v1/me/payments/sepay/test-payments/{id}": {
      "get": {
        "summary": "Exact recipient detail for unified invoice screen, independent of latest-20 list; no-store; foreign or owner-only receipt returns404",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Saved/private result; Cache-Control no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or provider token/data"
          },
          "401": {
            "description": "Missing/invalid session or webhook API key"
          },
          "403": {
            "description": "Role/account verification denied"
          },
          "404": {
            "description": "Not exact invoice party"
          },
          "409": {
            "description": "Stale version, invoice not SENT, missing config/public URL, fractional VND"
          },
          "503": {
            "description": "Provider unavailable"
          }
        }
      }
