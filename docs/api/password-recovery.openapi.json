{
  "openapi": "3.0.3",
  "info": {
    "title": "Password recovery email OTP",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/auth/password-recovery": {
      "post": {
        "summary": "Request password recovery OTP",
        "description": "Public CSRF-protected POST. Read token/headerName from GET /api/v1/auth/csrf. Request responses are generic for unavailable accounts. OTP/proof each expires after 10 minutes. Five wrong OTPs invalidate challenge. Reset keeps account status and external login configuration, revokes all sessions. Password min 12 characters and max 72 UTF-8 bytes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Private response, Cache-Control no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OtpChallenge"
                }
              }
            }
          },
          "400": {
            "description": "Invalid/expired/used OTP or proof, mismatched or reused password"
          },
          "403": {
            "description": "CSRF required"
          },
          "503": {
            "description": "OTP configuration/delivery unavailable"
          }
        }
      }
    },
    "/api/v1/auth/password-recovery/verify": {
      "post": {
        "summary": "Verify OTP and issue one-time reset proof",
        "description": "Public CSRF-protected POST. Read token/headerName from GET /api/v1/auth/csrf. Request responses are generic for unavailable accounts. OTP/proof each expires after 10 minutes. Five wrong OTPs invalidate challenge. Reset keeps account status and external login configuration, revokes all sessions. Password min 12 characters and max 72 UTF-8 bytes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Private response, Cache-Control no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResetProof"
                }
              }
            }
          },
          "400": {
            "description": "Invalid/expired/used OTP or proof, mismatched or reused password"
          },
          "403": {
            "description": "CSRF required"
          },
          "503": {
            "description": "OTP configuration/delivery unavailable"
          }
        }
      }
    },
    "/api/v1/auth/password-recovery/reset": {
      "post": {
        "summary": "Reset password and revoke all sessions",
        "description": "Public CSRF-protected POST. Read token/headerName from GET /api/v1/auth/csrf. Request responses are generic for unavailable accounts. OTP/proof each expires after 10 minutes. Five wrong OTPs invalidate challenge. Reset keeps account status and external login configuration, revokes all sessions. Password min 12 characters and max 72 UTF-8 bytes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetInput"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Private response, Cache-Control no-store"
          },
          "400": {
            "description": "Invalid/expired/used OTP or proof, mismatched or reused password"
          },
          "403": {
            "description": "CSRF required"
          },
          "503": {
            "description": "OTP configuration/delivery unavailable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OtpChallenge": {
        "type": "object",
        "required": [
          "challengeId",
          "maskedEmail",
          "expiresAt"
        ],
        "properties": {
          "challengeId": {
            "type": "string",
            "maxLength": 36
          },
          "maskedEmail": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "EmailInput": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          }
        }
      },
      "VerifyInput": {
        "type": "object",
        "required": [
          "challengeId",
          "code"
        ],
        "properties": {
          "challengeId": {
            "type": "string",
            "maxLength": 36
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          }
        }
      },
      "ResetProof": {
        "type": "object",
        "required": [
          "challengeId",
          "resetToken",
          "expiresAt"
        ],
        "properties": {
          "challengeId": {
            "type": "string"
          },
          "resetToken": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ResetInput": {
        "type": "object",
        "required": [
          "challengeId",
          "resetToken",
          "newPassword",
          "confirmPassword"
        ],
        "properties": {
          "challengeId": {
            "type": "string",
            "maxLength": 36
          },
          "resetToken": {
            "type": "string",
            "maxLength": 100
          },
          "newPassword": {
            "type": "string",
            "minLength": 12,
            "maxLength": 72
          },
          "confirmPassword": {
            "type": "string",
            "maxLength": 72
          }
        }
      }
    }
  }
}
