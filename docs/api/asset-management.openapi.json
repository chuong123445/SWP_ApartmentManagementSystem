{
  "openapi": "3.0.3",
  "info": {
    "title": "An Cu — self asset management and asset-bound lessor activation",
    "version": "2.0.0",
    "description": "Updated 24 November 2026: Auth0/VNeID is account authentication/identity verification only. Property source selection, import, append and consent writes are retired. All new property rights use manual input and dossier/Admin review. Historical property provenance remains readable without automatic data reset or demotion."
  },
  "security": [
    {
      "internalBearer": []
    }
  ],
  "paths": {
    "/api/v1/me/properties": {
      "get": {
        "summary": "Own Property→Apartment groups, including own drafts; no operational role granted",
        "responses": {
          "200": {
            "description": "Private no-store result.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Groups"
                }
              }
            }
          },
          "400": {
            "description": "Invalid/unknown fields, invalid image list"
          },
          "401": {
            "description": "Missing/revoked session"
          },
          "403": {
            "description": "Ineligible account, missing VERIFIED evidence or CSRF"
          },
          "404": {
            "description": "Resource is not owned by current account"
          },
          "409": {
            "description": "Stale version, apartment not VACANT, PENDING_REQUESTS_EXIST"
          }
        }
      }
    },
    "/api/v1/me/property-source-consent": {
      "get": {
        "summary": "Legacy status: consented=false and assetServiceAvailable=false",
        "responses": {
          "200": {
            "description": "Private no-store result.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsentStatus"
                }
              }
            }
          },
          "400": {
            "description": "Invalid/unknown fields, invalid image list"
          },
          "401": {
            "description": "Missing/revoked session"
          },
          "403": {
            "description": "Ineligible account, missing VERIFIED evidence or CSRF"
          },
          "404": {
            "description": "Resource is not owned by current account"
          },
          "409": {
            "description": "Stale version, apartment not VACANT, PENDING_REQUESTS_EXIST"
          }
        },
        "deprecated": true,
        "description": "Authenticated account compatibility response only; no provider read and no source authorization."
      },
      "post": {
        "summary": "Retired property source operation",
        "responses": {
          "410": {
            "description": "PROPERTY_SOURCE_RETIRED — use manual property dossier flow"
          },
          "401": {
            "description": "Authentication required"
          },
          "400": {
            "description": "Invalid legacy request body"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsentInput"
              }
            }
          }
        },
        "security": [
          {
            "internalBearer": [],
            "csrf": []
          }
        ],
        "deprecated": true,
        "description": "Authenticated valid requests return 410 PROPERTY_SOURCE_RETIRED. No Auth0 property read, import, publication or role grant is performed. Old consent cannot authorize this operation."
      }
    },
    "/api/v1/me/apartments/{id}": {
      "patch": {
        "summary": "Update marketing information only; exact owner/version; legal fields and prices excluded",
        "responses": {
          "204": {
            "description": "Saved; no-store. Prices route returns existing OwnerApartmentResponse200."
          },
          "400": {
            "description": "Invalid/unknown fields, invalid image list"
          },
          "401": {
            "description": "Missing/revoked session"
          },
          "403": {
            "description": "Ineligible account, missing VERIFIED evidence or CSRF"
          },
          "404": {
            "description": "Resource is not owned by current account"
          },
          "409": {
            "description": "Stale version, apartment not VACANT, PENDING_REQUESTS_EXIST"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Information"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        ]
      }
    },
    "/api/v1/me/apartments/{id}/prices": {
      "patch": {
        "summary": "Only exact owned VACANT apartment with no PENDING requests; row lock and version; existing contracts unchanged",
        "responses": {
          "200": {
            "description": "Saved; no-store. Prices route returns existing OwnerApartmentResponse200."
          },
          "400": {
            "description": "Invalid/unknown fields, invalid image list"
          },
          "401": {
            "description": "Missing/revoked session"
          },
          "403": {
            "description": "Ineligible account, missing VERIFIED evidence or CSRF"
          },
          "404": {
            "description": "Resource is not owned by current account"
          },
          "409": {
            "description": "Stale version, apartment not VACANT, PENDING_REQUESTS_EXIST"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Prices"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        ]
      }
    },
    "/api/v1/me/properties/{id}/images": {
      "put": {
        "summary": "Replace ordered Property gallery with1–4own retained/staged images; parent lock/version bump, no cross-asset images",
        "responses": {
          "204": {
            "description": "Saved; no-store. Prices route returns existing OwnerApartmentResponse200."
          },
          "400": {
            "description": "Invalid/unknown fields, invalid image list"
          },
          "401": {
            "description": "Missing/revoked session"
          },
          "403": {
            "description": "Ineligible account, missing VERIFIED evidence or CSRF"
          },
          "404": {
            "description": "Resource is not owned by current account"
          },
          "409": {
            "description": "Stale version, apartment not VACANT, PENDING_REQUESTS_EXIST"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Gallery"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        ]
      }
    },
    "/api/v1/me/rental-properties/{id}/withdraw": {
      "post": {
        "summary": "Remove own unfinished property or withdraw initial pending dossier",
        "description": "Authenticated exact applicant only. Locks account/property/dossiers and checks property version. Sets property WITHDRAWN, withdrawal timestamp, pending dossiers WITHDRAWN and completes its listing draft. Excludes withdrawn property/units from management and inventory. Keeps private submitted evidence/history. Repeated own withdrawal is idempotent. Approved/source properties, previous approved rights and any public/hidden/occupied unit or rental history block withdrawal. Not a command to revoke existing approved rights or leases. After withdrawal (including retry), an OWNER with no remaining APPROVED property becomes CUSTOMER in the same transaction. Other approved assets preserve OWNER; Admin is unchanged. Client must reload /me for current roles. Direct database cleanup must reconcile memberships separately.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "version"
                ],
                "properties": {
                  "version": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Removed from active lists; Cache-Control: no-store"
          },
          "400": {
            "description": "Missing/invalid version"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Account is not an eligible applicant"
          },
          "404": {
            "description": "Not owned/not found"
          },
          "409": {
            "description": "STALE_VERSION, PROPERTY_ALREADY_APPROVED or PROPERTY_IN_USE"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "internalBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "csrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-XSRF-TOKEN"
      }
    },
    "schemas": {
      "Image": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "url"
        ]
      },
      "Information": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "description": {
            "type": "string",
            "maxLength": 3000
          },
          "maxOccupants": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "amenities": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        },
        "required": [
          "version",
          "title",
          "description",
          "maxOccupants",
          "amenities"
        ]
      },
      "Gallery": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "imageIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        },
        "required": [
          "version",
          "imageIds"
        ]
      },
      "Prices": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "monthlyRent": {
            "type": "string",
            "description": "DECIMAL(15,2), monthlyRent>0; utility prices>=0"
          },
          "electricityUnitPrice": {
            "type": "string",
            "description": "DECIMAL(15,2), monthlyRent>0; utility prices>=0"
          },
          "waterUnitPrice": {
            "type": "string",
            "description": "DECIMAL(15,2), monthlyRent>0; utility prices>=0"
          }
        },
        "required": [
          "version"
        ],
        "anyOf": [
          {
            "required": [
              "monthlyRent"
            ]
          },
          {
            "required": [
              "electricityUnitPrice"
            ]
          },
          {
            "required": [
              "waterUnitPrice"
            ]
          }
        ],
        "description": "Partial PATCH: version and at least one price. Omitted prices remain unchanged, including null legacy utilities. Explicit null/empty prices rejected; zero utilities allowed. Owner, version, VACANT and no-PENDING checks unchanged."
      },
      "ConsentInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "consent": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "required": [
          "consent",
          "version"
        ]
      },
      "ConsentStatus": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "consented": {
            "type": "boolean"
          },
          "assetServiceAvailable": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "required": [
          "consented",
          "assetServiceAvailable",
          "version"
        ]
      },
      "Management": {
        "type": "object",
        "nullable": true,
        "description": "Only exact owner of Property receives this object; cannot be supplied by client. Read-only self draft does not imply operational OWNER authority.",
        "properties": {
          "propertyId": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "propertyVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "approvalStatus": {
            "type": "string"
          },
          "verificationSource": {
            "type": "string",
            "nullable": true
          },
          "canEdit": {
            "type": "boolean"
          },
          "pricesEditable": {
            "type": "boolean"
          },
          "priceLockReason": {
            "type": "string",
            "nullable": true
          },
          "gallery": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Image"
            }
          },
          "roomNumber": {
            "type": "string",
            "nullable": true
          },
          "maxOccupants": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "Group": {
        "type": "object",
        "description": "Private Property with its exact owned apartments. Shape follows existing OwnerPropertyResponse/OwnerApartmentResponse, filtered by current account, not a caller actor ID.",
        "properties": {
          "property": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              },
              "name": {
                "type": "string"
              },
              "approvalStatus": {
                "type": "string"
              },
              "rightType": {
                "type": "string",
                "nullable": true
              },
              "version": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              }
            }
          },
          "apartments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                "propertyId": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                "title": {
                  "type": "string"
                },
                "advertisedMonthlyRent": {
                  "type": "string"
                },
                "publicationStatus": {
                  "type": "string"
                },
                "availability": {
                  "type": "string"
                },
                "thumbnail": {
                  "type": "string"
                },
                "version": {
                  "type": "integer",
                  "format": "int64",
                  "minimum": 0
                }
              }
            }
          }
        }
      },
      "Groups": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Group"
        }
      }
    }
  }
}
