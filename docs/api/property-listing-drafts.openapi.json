{
  "openapi": "3.1.0",
  "info": {
    "title": "Private property listing drafts",
    "version": "1.0.1",
    "description": "L01-L02. Creation requestKey retries return the existing owned draft. Completed-command retries return the completed view. Creation limits unfinished drafts to 20. Completion uses typed validation and a single transaction. SQL acceptance pending environment access."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
