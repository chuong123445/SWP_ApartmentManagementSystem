    "/api/v1/me/listing-drafts/{id}/complete": {
      "post": {
        "operationId": "completeListingDraft",
        "responses": {
          "200": {
            "description": "Private response",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/View"
                }
              }
            }
          },
          "400": {
            "description": "Invalid command",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./property-dossiers.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./property-dossiers.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Account ineligible",
            "content": {
              "application/json": {
