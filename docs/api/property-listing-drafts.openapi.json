          "404": {
            "description": "Resource unavailable to actor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./property-dossiers.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Stale version or draft not editable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./property-dossiers.openapi.json#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Start"
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listListingDrafts",
        "responses": {
          "200": {
            "description": "Private response",
