    "/api/v1/me/rental-properties/{id}/ai-extract": {
      "post": {
        "operationId": "extractPrivatePropertyEvidence",
        "responses": {
          "400": {
            "description": "Request rejected according to authorization, validation, source version or provider status"
          },
          "401": {
            "description": "Request rejected according to authorization, validation, source version or provider status"
          },
          "403": {
            "description": "Request rejected according to authorization, validation, source version or provider status"
          },
          "404": {
            "description": "Request rejected according to authorization, validation, source version or provider status"
          },
          "409": {
            "description": "Request rejected according to authorization, validation, source version or provider status"
          },
          "503": {
            "description": "Request rejected according to authorization, validation, source version or provider status"
          },
          "200": {
            "description": "OwnerPrecheck view including review.fileId, readable, documentType, extractedFields[field,value,page?], findings, sourceHash, model, runId and promptVersion. Requires exact-owned selected evidence and matching sourceHash with consent."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrecheckRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ]
      }
    },
    "/api/v1/me/listing-description/suggest": {
      "post": {
        "summary": "Suggest a Vietnamese room description using supplied facts and optional owned room photos",
        "description": "ACTIVE authorized Owner/Customer. Maximum four image IDs, each uploaded by this account. Raster images are re-encoded and bounded before Gemini. No private dossier images or caller-selected external URLs. User explicitly applies the suggestion.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "areaM2",
                  "monthlyRent"
                ],
                "properties": {
                  "areaM2": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "monthlyRent": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "floor": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 200
                  },
                  "maxOccupants": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1,
                    "maximum": 1000
                  },
                  "bedrooms": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 100
                  },
                  "bathrooms": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 100
                  },
                  "amenities": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "maxItems": 20,
                    "items": {
                      "type": "string",
                      "maxLength": 100
                    }
                  },
                  "imageIds": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "maxItems": 4,
                    "items": {
                      "type": [
                        "string",
                        "integer"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Description suggestion",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "description"
                  ],
                  "properties": {
                    "description": {
                      "type": "string",
                      "maxLength": 3000
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid facts/photo"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Account cannot use this feature"
          },
          "404": {
            "description": "Image does not belong to this account"
          },
          "429": {
            "description": "Request limit"
          },
          "503": {
            "description": "Provider not configured/unavailable or invalid response"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GalleryUpdate": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "imageIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "version",
          "imageIds"
        ]
      },
      "PropertyFields": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 150
          },
          "address": {
            "type": "string",
            "maxLength": 300
          },
          "city": {
            "type": "string",
            "maxLength": 80
          },
          "district": {
            "type": "string",
            "maxLength": 80
          },
          "ward": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          }
        },
        "required": [
          "name",
          "address",
          "city",
          "district"
        ]
      },
      "PropertyGroup": {
        "type": "object",
        "properties": {
          "propertyId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "minRent": {
            "type": "string"
          },
          "maxRent": {
            "type": "string"
          },
          "minArea": {
            "type": "string"
          },
          "maxArea": {
            "type": "string"
          },
          "thumbnail": {
            "type": "string"
          },
          "matchingRooms": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "propertyId",
          "name",
          "address",
          "minRent",
          "maxRent",
          "minArea",
          "maxArea",
          "thumbnail",
          "matchingRooms"
        ]
      },
      "GroupPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PropertyGroup"
            }
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer"
          }
        },
        "required": [
          "items",
          "page",
          "size",
          "totalElements",
          "totalPages"
        ]
      },
      "PrecheckRequest": {
        "type": "object",
        "properties": {
          "draft": {
            "$ref": "./property-dossiers.openapi.json#/components/schemas/DossierSubmit"
          },
          "fileId": {
            "type": [
              "string",
              "integer",
              "null"
            ]
          },
          "sourceHash": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "consent": {
            "type": "boolean"
          },
          "propertyFields": {
            "$ref": "#/components/schemas/PropertyFields"
          }
        },
        "required": [
          "draft"
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
