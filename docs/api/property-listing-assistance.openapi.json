            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupPage"
                }
              }
            }
          },
          "400": {
            "description": "Request rejected according to authorization, validation, source version or provider status"
          },
          "401": {
            "description": "Request rejected according to authorization, validation, source version or provider status"
          },
          "403": {
            "description": "Request rejected according to authorization, validation, source version or provider status"
          },
          "404": {
            "description": "Request rejected according to authorization, validation, source version or provider status"
          },
          "409": {
            "description": "Request rejected according to authorization, validation, source version or provider status"
          },
          "503": {
            "description": "Request rejected according to authorization, validation, source version or provider status"
          }
        },
        "security": [],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "city",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "district",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ward",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "minRent",
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "maxRent",
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "minArea",
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
