{
  "openapi": "3.1.0",
  "info": {
    "title": "Property listing evidence, room images and grouped discovery",
    "version": "1.0.0",
    "description": "Backend contracts implemented. SQL acceptance and live provider checks pending. Precheck and acknowledge endpoints also accept optional propertyFields. These declarations participate in sourceHash and are advisory input. Upload in the listing wizard automatically requests extraction and fills readable fields, including city/district/ward. Dates remain ISO yyyy-MM-dd in API responses and requests, while UI/PDF use dd/MM/yyyy. Provider DMY values are normalized before comparison. User-corrected values remain editable and are preserved across automatic fills."
  },
  "paths": {
    "/api/v1/me/apartments/{id}/images": {
      "put": {
        "operationId": "replaceUnitGallery",
        "responses": {
          "204": {
            "description": "Success",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            }
          },
          "400": {
            "description": "Request rejected according to authorization, validation, source version or provider status"
          },
          "401": {
            "description": "Request rejected according to authorization, validation, source version or provider status"
          },
          "403": {
            "description": "Request rejected according to authorization, validation, source version or provider status"
          },
          "404": {
            "description": "Request rejected according to authorization, validation, source version or provider status"
          },
          "409": {
            "description": "Request rejected according to authorization, validation, source version or provider status"
          },
          "503": {
            "description": "Request rejected according to authorization, validation, source version or provider status"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GalleryUpdate"
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ]
      }
    },
    "/api/v1/apartments/property-groups": {
